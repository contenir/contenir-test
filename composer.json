{
    "name": "contenir/contenir-test",
    "description": "Test helpers shared by Contenir packages and sites: a PSR-11 container, a fixed PSR-20 clock, a recording PSR-3 logger, a scratch directory, and an in-memory SQLite copy of a MySQL schema.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "testing",
        "phpunit",
        "psr-11",
        "sqlite"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-test/issues",
        "source": "https://github.com/contenir/contenir-test"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-pdo_sqlite": "*",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Test\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Test\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
